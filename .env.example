# ─────────────────────────────────────────────────────────────
# Modelo do arquivo .env (senhas e ajustes do ambiente)
#
#   1) Copie este arquivo com o nome .env
#   2) Troque as senhas abaixo
#
# O .env NUNCA vai para o GitHub (está no .gitignore).
# ─────────────────────────────────────────────────────────────

APP_VERSION=1.0.0
# Porta para abrir no navegador: http://localhost:8080
APP_PORT=8080

# Banco de dados
POSTGRES_DB=estulanches
POSTGRES_USER=estulanches
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# Conta da equipe da cantina (é com ela que se entra na aba "Cantina")
CANTINA_LOGIN=cantina
# mínimo 10 caracteres
CANTINA_SENHA=troque-esta-senha-da-cantina

# Quanto tempo o login dura (horas)
SESSAO_HORAS=8

# Ajustes de desempenho e proteção
DB_POOL_MAX=10
RATE_LIMIT_MAX=300
RATE_LIMIT_PEDIDOS_MAX=20
RATE_LIMIT_LOGIN_MAX=10
