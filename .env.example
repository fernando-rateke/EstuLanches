# Copie para .env e troque os valores:  cp .env.example .env
# NUNCA faça commit do arquivo .env (ele está no .gitignore).

APP_VERSION=1.0.0
APP_PORT=8080

POSTGRES_DB=estulanches
POSTGRES_USER=estulanches
# Gere uma senha forte, ex.: openssl rand -base64 24
POSTGRES_PASSWORD=troque-esta-senha

# Token da tela "Cantina" (mínimo 16 caracteres). Ex.: openssl rand -hex 24
ADMIN_TOKEN=troque-este-token-por-um-bem-longo

DB_POOL_MAX=10
RATE_LIMIT_MAX=300
RATE_LIMIT_PEDIDOS_MAX=20
