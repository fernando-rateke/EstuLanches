{
  "name": "estulanches",
  "version": "1.0.0",
  "description": "EstuLanches - gestão de cardápio e pedidos da cantina escolar",
  "main": "src/server.js",
  "author": "Fernando Rateke Neto",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand --coverage",
